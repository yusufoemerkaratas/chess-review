{
  "manifest_version": 3,
  "name": "Chess Game Review",
  "version": "1.0.0",
  "description": "Review your finished lichess and chess.com games with Stockfish, right in your browser.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["https://lichess.org/*", "https://www.chess.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "host_permissions": ["https://lichess.org/*", "https://www.chess.com/*", "https://api.chess.com/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "browser_specific_settings": { "gecko": { "id": "chess-review@yusufoemerkaratas", "strict_min_version": "128.0" } }
}
